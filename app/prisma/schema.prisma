generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/servyauto_manager_v89/app/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          RolUsuario @default(ADMIN)
  activo        Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  accounts          Account[]
  sessions          Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cliente {
  id             String     @id @default(cuid())
  nombre         String
  apellido       String?
  email          String?    @unique
  telefono       String
  direccion      String?
  documento      String?    @map("dni")
  clienteParking Boolean    @default(false) // Indica si el cliente es abonado del parking
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  citas           Cita[]
  facturas        Factura[]
  vehiculos       Vehiculo[]
  serviciosRapidos ServicioTaller[]

  @@map("clientes")
}

model Vehiculo {
  id            String   @id @default(cuid())
  marca         String
  modelo        String
  anio          Int
  color         String?
  matricula     String   @unique
  kilometraje   Int?
  motor         String?
  combustible   String?
  observaciones String?
  clienteId     String
  createdAt     DateTime @default(now())
  updatedAt         DateTime @updatedAt
  citas             Cita[]
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  serviciosRapidos  ServicioTaller[]

  @@map("vehiculos")
}

model Servicio {
  id               String           @id @default(cuid())
  nombre           String
  descripcion      String?
  precio           Float
  duracion         Int
  activo           Boolean          @default(true)
  ordenPreferencia Int              @default(999)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cita_servicios   cita_servicios[]

  @@map("servicios")
}

model Cita {
  id             String           @id @default(cuid())
  fecha          DateTime
  horaInicio     String
  horaFin        String
  box            String
  estado         EstadoCita       @default(PENDIENTE)
  observaciones  String?
  metodoPago     MetodoPago?
  total          Float?
  ticketsUsados  Int              @default(0) // Número de tickets de parking utilizados
  clienteId      String
  vehiculoId     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cita_servicios cita_servicios[]
  cliente        Cliente          @relation(fields: [clienteId], references: [id])
  vehiculo       Vehiculo         @relation(fields: [vehiculoId], references: [id])
  facturas       Factura?

  @@map("citas")
}

model Factura {
  id               String          @id @default(cuid())
  numero           String          @unique
  tipo             TipoFactura     @default(TICKET)
  fecha            DateTime        @default(now())
  subtotal         Float
  iva              Float
  total            Float
  estado           EstadoFactura   @default(PENDIENTE)
  metodoPago       MetodoPago?
  clienteId        String
  citaId           String?         @unique
  datosFacturacion String?
  pdfPath          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  factura_items     factura_items[]
  citas             Cita?           @relation(fields: [citaId], references: [id])
  cliente           Cliente         @relation(fields: [clienteId], references: [id])
  servicioRapido    ServicioTaller?

  @@map("facturas")
}

model Configuracion {
  id          String            @id @default(cuid())
  clave       String            @unique
  valor       String
  tipo        TipoConfiguracion
  categoria   String
  descripcion String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("configuraciones")
}

model cita_servicios {
  id         String   @id
  citaId     String
  servicioId String
  precio     Float
  citas      Cita     @relation(fields: [citaId], references: [id], onDelete: Cascade)
  servicios  Servicio @relation(fields: [servicioId], references: [id])

  @@unique([citaId, servicioId])
}

model factura_items {
  id          String  @id
  descripcion String
  cantidad    Int
  precio      Float
  total       Float
  facturaId   String
  facturas    Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
}

model reservas {
  id        String        @id
  nombre    String
  apellido  String?
  email     String
  telefono  String
  fecha     DateTime
  hora      String
  vehiculo  String
  servicio  String
  mensaje   String?
  estado    EstadoReserva @default(PENDIENTE)
  createdAt DateTime      @default(now())
  updatedAt DateTime
}

model Gasto {
  id                    String      @id @default(cuid())
  concepto              String
  fecha                 DateTime
  proveedor             String?
  tipoGasto             String
  importe               Float
  metodoPago            MetodoPago? // Método de pago del gasto
  tipo                  TipoFactura @default(TICKET)
  iva                   Float       @default(21)
  adjunto               Boolean     @default(false)
  // Campos fiscales para facturas
  numeroFactura         String?
  proveedorCIF          String?
  proveedorDireccion    String?
  proveedorCodigoPostal String?
  proveedorCiudad       String?
  proveedorProvincia    String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("gastos")
}

enum RolUsuario {
  SUPER_ADMIN
  ADMIN
  OPERADOR
  CLIENTE
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  EN_PROCESO
  LISTO_PARA_RECOGER
  COMPLETADA
  CANCELADA
  NO_SHOW
}

enum MetodoPago {
  EFECTIVO
  TPV_SUMUP
  TPV_UNICAJA
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  VENCIDA
  CANCELADA
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

enum TipoConfiguracion {
  TEXTO
  NUMERO
  BOOLEANO
  JSON
  EMAIL
  TELEFONO
  DIRECCION
  ARCHIVO
}

enum TipoFactura {
  TICKET
  FACTURA
}

model CierreCaja {
  id                  String   @id @default(cuid())
  fechaInicio         DateTime
  fechaFin            DateTime
  totalEfectivo       Float    // Total de ventas en efectivo
  totalTPVSumup       Float    // Total de ventas con TPV SUMUP
  totalTPVUnicaja     Float    // Total de ventas con TPV UNICAJA
  gastosEfectivo      Float    // Total de gastos en efectivo
  gastosTarjeta       Float    // Total de gastos con tarjeta
  efectivoFinal       Float    // Efectivo final (total efectivo - gastos efectivo)
  observaciones       String?
  usuarioId           String   // Usuario que realizó el cierre
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("cierres_caja")
}

model InventarioTickets {
  id            String                  @id @default(cuid())
  fecha         DateTime                @default(now())
  tipo          TipoMovimientoTicket    @default(COMPRA)
  cantidad      Int                     // Cantidad de tickets (positivo para compra, negativo para uso)
  saldoAnterior Int                     // Saldo antes del movimiento
  saldoActual   Int                     // Saldo después del movimiento
  concepto      String?                 // Descripción del movimiento
  usuarioId     String?                 // Usuario que realizó el movimiento
  citaId        String?                 // ID de la cita si es un consumo
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@map("inventario_tickets")
}

enum TipoMovimientoTicket {
  COMPRA      // Compra de tickets
  CONSUMO     // Uso de tickets en una cita
  AJUSTE      // Ajuste manual del inventario
}

model GaleriaAntesDespues {
  id             Int      @id @default(autoincrement())
  titulo         String
  servicio       String
  vehiculo       String
  imagenAntes    String   // URL de la imagen "antes"
  imagenDespues  String   // URL de la imagen "después"
  descripcion    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("galeria_antes_despues")
}

model Portfolio {
  id          Int      @id @default(autoincrement())
  titulo      String
  servicio    String
  vehiculo    String?
  categoria   String   @default("MEDIO") // PEQUENO, MEDIO, GRANDE, SUPER_GRANDE
  imagenes    String[] // Array de URLs de imágenes
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("portfolio")
}

// ========================================
// MÓDULO SERVICIOS RÁPIDOS / TALLER
// ========================================

// Tipos de servicio predefinidos con márgenes
model TipoServicio {
  id              Int              @id @default(autoincrement())
  nombre          String           @unique // "Cambio de Batería", "Pastillas de Freno", etc.
  codigo          String           @unique // "BAT", "FRE", "ACE", etc.
  margenDefecto   Float            @default(30) // Margen en porcentaje
  categoria       String           @default("OTROS") // BATERIAS, FRENOS, ACEITE, NEUMATICOS, ELECTRICA, OTROS
  descripcion     String?
  activo          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("tipos_servicio")
}

// Servicios rápidos de taller (baterías, frenos, aceite, etc.)
model ServicioTaller {
  id                    String      @id @default(cuid())
  concepto              String      // Ej: "Cambio de batería", "Reparación frenos"
  fecha                 DateTime    @default(now())
  
  // Cliente y vehículo (en vez de proveedor como en gastos)
  clienteId             String
  cliente               Cliente     @relation(fields: [clienteId], references: [id])
  vehiculoId            String
  vehiculo              Vehiculo    @relation(fields: [vehiculoId], references: [id])
  
  // Categoría del servicio
  tipoGasto             String      // Reutilizamos este campo para "tipo de servicio"
  
  // Costes y precios
  costeProducto         Float       @default(0) // Coste interno del producto
  costeManoObra         Float       @default(0) // Coste interno mano de obra
  precioProducto        Float       // Precio de venta del producto al cliente
  precioManoObra        Float       // Precio de mano de obra al cliente
  importe               Float       // Total = precioProducto + precioManoObra
  margen                Float       // Margen = (precioProducto - costeProducto)
  
  // Documento y pago
  metodoPago            MetodoPago?
  tipo                  TipoFactura @default(TICKET)
  iva                   Float       @default(21)
  adjunto               Boolean     @default(false)
  
  // Campos fiscales para facturas (cuando tipo=FACTURA)
  numeroFactura         String?
  clienteCIF            String?     // CIF del cliente
  clienteDireccion      String?
  clienteCodigoPostal   String?
  clienteCiudad         String?
  clienteProvincia      String?
  
  // Factura generada automáticamente
  facturaId             String?     @unique
  factura               Factura?    @relation(fields: [facturaId], references: [id])
  
  // Timestamps
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("servicios_taller")
}