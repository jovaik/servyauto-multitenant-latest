generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/servyauto_manager_v89/app/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          RolUsuario @default(ADMIN)
  activo        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cliente {
  id        String     @id @default(cuid())
  nombre    String
  apellido  String?
  email     String?    @unique
  telefono  String
  direccion String?
  documento String?    @map("dni")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  citas     Cita[]
  facturas  Factura[]
  vehiculos Vehiculo[]

  @@map("clientes")
}

model Vehiculo {
  id            String   @id @default(cuid())
  marca         String
  modelo        String
  anio          Int
  color         String?
  matricula     String   @unique
  kilometraje   Int?
  motor         String?
  combustible   String?
  observaciones String?
  clienteId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  citas         Cita[]
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("vehiculos")
}

model Servicio {
  id             String           @id @default(cuid())
  nombre         String
  descripcion    String?
  precio         Float
  duracion       Int
  activo         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cita_servicios cita_servicios[]

  @@map("servicios")
}

model Cita {
  id             String           @id @default(cuid())
  fecha          DateTime
  horaInicio     String
  horaFin        String
  box            String
  estado         EstadoCita       @default(PENDIENTE)
  observaciones  String?
  metodoPago     MetodoPago?
  total          Float?
  clienteId      String
  vehiculoId     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cita_servicios cita_servicios[]
  cliente        Cliente          @relation(fields: [clienteId], references: [id])
  vehiculo       Vehiculo         @relation(fields: [vehiculoId], references: [id])
  facturas       Factura?

  @@map("citas")
}

model Factura {
  id               String          @id @default(cuid())
  numero           String          @unique
  tipo             TipoFactura     @default(TICKET)
  fecha            DateTime        @default(now())
  subtotal         Float
  iva              Float
  total            Float
  estado           EstadoFactura   @default(PENDIENTE)
  metodoPago       MetodoPago?
  clienteId        String
  citaId           String?         @unique
  datosFacturacion String?
  pdfPath          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  factura_items    factura_items[]
  citas            Cita?           @relation(fields: [citaId], references: [id])
  cliente          Cliente         @relation(fields: [clienteId], references: [id])

  @@map("facturas")
}

model Configuracion {
  id          String            @id @default(cuid())
  clave       String            @unique
  valor       String
  tipo        TipoConfiguracion
  categoria   String
  descripcion String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("configuraciones")
}

model cita_servicios {
  id         String   @id
  citaId     String
  servicioId String
  precio     Float
  citas      Cita     @relation(fields: [citaId], references: [id], onDelete: Cascade)
  servicios  Servicio @relation(fields: [servicioId], references: [id])

  @@unique([citaId, servicioId])
}

model factura_items {
  id          String  @id
  descripcion String
  cantidad    Int
  precio      Float
  total       Float
  facturaId   String
  facturas    Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
}

model reservas {
  id        String        @id
  nombre    String
  apellido  String?
  email     String
  telefono  String
  fecha     DateTime
  hora      String
  vehiculo  String
  servicio  String
  mensaje   String?
  estado    EstadoReserva @default(PENDIENTE)
  createdAt DateTime      @default(now())
  updatedAt DateTime
}

model Gasto {
  id                    String      @id @default(cuid())
  concepto              String
  fecha                 DateTime
  proveedor             String?
  tipoGasto             String
  importe               Float
  metodoPago            MetodoPago? // Método de pago del gasto
  tipo                  TipoFactura @default(TICKET)
  iva                   Float       @default(21)
  adjunto               Boolean     @default(false)
  // Campos fiscales para facturas
  numeroFactura         String?
  proveedorCIF          String?
  proveedorDireccion    String?
  proveedorCodigoPostal String?
  proveedorCiudad       String?
  proveedorProvincia    String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("gastos")
}

enum RolUsuario {
  SUPER_ADMIN
  ADMIN
  OPERADOR
  CLIENTE
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  EN_PROCESO
  COMPLETADA
  CANCELADA
  NO_SHOW
}

enum MetodoPago {
  EFECTIVO
  TPV_SUMUP
  TPV_UNICAJA
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  VENCIDA
  CANCELADA
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

enum TipoConfiguracion {
  TEXTO
  NUMERO
  BOOLEANO
  JSON
  EMAIL
  TELEFONO
  DIRECCION
  ARCHIVO
}

enum TipoFactura {
  TICKET
  FACTURA
}

model CierreCaja {
  id                  String   @id @default(cuid())
  fechaInicio         DateTime
  fechaFin            DateTime
  totalEfectivo       Float    // Total de ventas en efectivo
  totalTPVSumup       Float    // Total de ventas con TPV SUMUP
  totalTPVUnicaja     Float    // Total de ventas con TPV UNICAJA
  gastosEfectivo      Float    // Total de gastos en efectivo
  gastosTarjeta       Float    // Total de gastos con tarjeta
  efectivoFinal       Float    // Efectivo final (total efectivo - gastos efectivo)
  observaciones       String?
  usuarioId           String   // Usuario que realizó el cierre
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("cierres_caja")
}
