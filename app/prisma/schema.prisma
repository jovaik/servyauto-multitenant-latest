
generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/servyauto_manager_v89/app/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          RolUsuario @default(ADMIN)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum RolUsuario {
  ADMIN
  MECANICO
  RECEPCIONISTA
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  apellido  String
  email     String?
  telefono  String
  direccion String?
  documento String?  @map("dni")
  vehiculos Vehiculo[]
  citas     Cita[]
  facturas  Factura[]
  tickets   Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clientes")
}

model Vehiculo {
  id            String   @id @default(cuid())
  marca         String
  modelo        String
  anio          Int
  color         String?
  matricula     String   @unique
  kilometraje   Int?
  motor         String?
  combustible   String?
  observaciones String?
  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  citas         Cita[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("vehiculos")
}

model Servicio {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  precio      Float
  duracion    Int      // Duración en minutos
  activo      Boolean  @default(true)
  citas       Cita[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("servicios")
}

model Cita {
  id                 String      @id @default(cuid())
  fecha              DateTime
  horaInicio         String
  horaFin            String
  clienteId          String
  vehiculoId         String
  servicioId         String
  mecanico           String?
  estado             EstadoCita  @default(PENDIENTE)
  observaciones      String?
  precioFinal        Float?
  metodoPago         MetodoPago?
  pagado             Boolean     @default(false)
  tipoDocumento      TipoDocumento?
  numeroDocumento    String?
  cliente            Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vehiculo           Vehiculo    @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  servicio           Servicio    @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("citas")
}

enum EstadoCita {
  PENDIENTE
  EN_CURSO
  COMPLETADA
  CANCELADA
}

enum MetodoPago {
  EFECTIVO
  TPV_SUMUP
  TPV_UNICAJA
}

enum TipoDocumento {
  TICKET
  FACTURA
}

model Factura {
  id              String   @id @default(cuid())
  numero          String   @unique
  fecha           DateTime @default(now())
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  subtotal        Float
  iva             Float
  total           Float
  pagada          Boolean  @default(false)
  metodoPago      MetodoPago?
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("facturas")
}

model Ticket {
  id              String   @id @default(cuid())
  numero          String   @unique
  fecha           DateTime @default(now())
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  subtotal        Float
  iva             Float
  total           Float
  pagado          Boolean  @default(false)
  metodoPago      MetodoPago?
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("tickets")
}

model SecuenciaDocumento {
  id              String   @id @default(cuid())
  tipo            TipoDocumento @unique
  ultimoNumero    Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@map("secuencias_documentos")
}
