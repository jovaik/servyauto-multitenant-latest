# ========================================
# ServyAuto Manager - Variables de Entorno
# ========================================
# Copia este archivo como .env y configura los valores

# ==================== BASE DE DATOS ====================
# URL de conexión a PostgreSQL
DATABASE_URL="postgresql://usuario:password@host:5432/basedatos?sslmode=require"

# ==================== AUTENTICACIÓN ====================
# Secreto para NextAuth (genera uno aleatorio)
NEXTAUTH_SECRET="genera-un-secreto-seguro-de-32-caracteres"
# URL base de la aplicación
NEXTAUTH_URL="https://tu-dominio.com"

# ==================== AWS S3 (Almacenamiento) ====================
AWS_PROFILE="default"
AWS_REGION="us-west-2"
AWS_BUCKET_NAME="tu-bucket-s3"
AWS_FOLDER_PREFIX="servyauto/"

# ==================== EMAIL (Opcional) ====================
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="tu-email@gmail.com"
EMAIL_PASSWORD="tu-contraseña-de-aplicacion"

# ==================== TWILIO (WhatsApp/SMS - Opcional) ====================
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="tu-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# ==================== GSCONTROL (Contabilidad - Opcional) ====================
GSCONTROL_API_KEY="gs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==================== SUMUP (Pagos - Opcional) ====================
SUMUP_API_KEY="sup_sk_xxxxxxxxxxxxxxxxxxxxxxxxx"
SUMUP_AFFILIATE_KEY="sup_afk_xxxxxxxxxxxxxxxxxxxxxxxxx"

# ==================== ABACUS AI (LLM APIs - Opcional) ====================
ABACUSAI_API_KEY="tu-api-key-aqui"

# ==================== URL PÚBLICA ====================
NEXT_PUBLIC_APP_URL="https://tu-dominio.com"
