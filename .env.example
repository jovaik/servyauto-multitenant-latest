
# Ejemplo de archivo .env para ServyAuto Manager v8.9
# Copia este archivo como .env y ajusta los valores

# ==========================================
# BASE DE DATOS
# ==========================================

# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:password@host:puerto/base_datos?schema=public
DATABASE_URL="postgresql://servyauto:TuPasswordSeguro123@localhost:5432/servyauto_db?schema=public"

# Si usas Docker Compose, el host es el nombre del servicio:
# DATABASE_URL="postgresql://servyauto:TuPasswordSeguro123@postgres:5432/servyauto_db?schema=public"


# ==========================================
# NEXTAUTH (Autenticación)
# ==========================================

# URL pública de tu aplicación
# Desarrollo local:
NEXTAUTH_URL="http://localhost:3000"
# Synology local:
# NEXTAUTH_URL="http://tu-synology.local:3000"
# Producción:
# NEXTAUTH_URL="https://servyauto.tudominio.com"

# Secret para encriptar tokens (IMPORTANTE: genera uno único)
# Generar con: openssl rand -base64 32
# O online: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="CAMBIA_ESTO_POR_UN_SECRET_ALEATORIO"


# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================

# Puerto de la aplicación (default: 3000)
PORT=3000

# Entorno (production | development)
NODE_ENV=production


# ==========================================
# OPCIONAL: Configuraciones adicionales
# ==========================================

# Nombre del negocio
# BUSINESS_NAME="ServyAuto"

# Timezone
# TZ="Europe/Madrid"
